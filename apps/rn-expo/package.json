{
  "name": "@cecistudy/rn-expo",
  "version": "0.0.0",
  "private": true,
  "description": "Laboratorio visual da migracao do cecistudy mobile para React Native + Expo. Mock visual, sem regra de negocio.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "check:tokens": "node scripts/tokens-sync.mjs",
    "check:classes": "node scripts/classes-check.mjs",
    "verify": "npm run typecheck && npm run check:tokens && npm run check:classes",
    "doctor": "expo-doctor"
  },
  "dependencies": {
    "@expo-google-fonts/dm-serif-display": "0.4.2",
    "@expo-google-fonts/inter": "0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "0.4.2",
    "@expo/metro-runtime": "^58.0.14",
    "expo": "58.0.14",
    "expo-blur": "58.0.4",
    "expo-font": "58.0.8",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.15",
    "expo-linear-gradient": "58.0.3",
    "expo-splash-screen": "58.0.10",
    "expo-status-bar": "58.0.3",
    "expo-system-ui": "58.0.6",
    "lucide-react-native": "1.58.0",
    "nativewind": "4.2.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-native": "0.88.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "19.3.0",
    "tailwindcss": "3.4.19",
    "typescript": "~5.8.2"
  }
}
