{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "jsxImportSource": "nativewind",
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "target": "esnext",
    "noUncheckedIndexedAccess": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "index.js",
    "nativewind-env.d.ts",
    "global.css",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/tokens/palette.js"
  ],
  "exclude": ["node_modules", "dist"]
}