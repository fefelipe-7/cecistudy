{
  "expo": {
    "name": "cecistudy ♡",
    "slug": "cecistudy-rn",
    "version": "0.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cecistudy",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#FFF9F0",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.cecistudy.app"
    },
    "android": {
      "package": "br.com.cecistudy.app",
      "adaptiveIcon": {
        "backgroundColor": "#FFF9F0"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-font", "expo-splash-screen"]
  }
}