{
  "name": "cecistudy",
  "private": true,
  "version": "1.0.95",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "!apps/rn-expo"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "assets": "node scripts/generate-assets.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:code": "biome lint .",
    "lint:code:fix": "biome lint --write .",
    "test": "vitest run",
    "test:ci": "vitest run --reporter=dot",
    "test:watch": "vitest",
    "test:domain": "vitest run --exclude 'src/**' --exclude 'apps/**'",
    "test:ui": "vitest run --exclude 'packages/**' --exclude 'apps/**'",
    "test:apps": "vitest run --exclude 'src/**' --exclude 'packages/**' --passWithNoTests",
    "check:boundaries": "node .github/scripts/check-boundaries.mjs",
    "check:voz": "node .github/scripts/check-boundaries.mjs --voz",
    "test:voz": "node .github/scripts/voz-fixture.mjs",
    "voz:baseline": "node .github/scripts/gerar-voice-allowlist.mjs --fase \"rebaixar: descreva o módulo migrado\"",
    "verify:contract": "node contracts/verify-schema.mjs",
    "verify:domain": "npm run typecheck && npm run test:domain && npm run check:boundaries && npm run test:voz && npm run verify:contract",
    "bundle:report": "node scripts/bundle-report.mjs",
    "build:web": "vite build",
    "build:mobile": "npm run build --workspace=apps/mobile",
    "verify:fast": "npm run typecheck && npm run test:ci && npm run check:boundaries && npm run test:voz && npm run verify:contract",
    "verify": "npm run verify:fast && npm run build:web && npm run bundle:report && npm run build:mobile",
    "content:build": "tsx content/build-catalog.mjs",
    "content:ensure": "tsx scripts/ensure-catalog.mjs",
    "predev": "npm run content:ensure",
    "prebuild": "npm run content:ensure",
    "preverify": "npm run content:ensure",
    "content:check": "tsx content/check-content.mjs",
    "content:report": "tsx content/report-content.mjs",
    "content:diff": "tsx content/diff-content.mjs",
    "db:verify": "tsx scripts/db-verify.mjs",
    "db:legacy-import": "tsx scripts/db-legacy-import.mjs",
    "cap:sync": "npm run build && cap sync",
    "cap:sync:web": "cap copy web",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/calendar": "^1.0.0",
    "@capacitor/camera": "^8.2.2",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@capgo/capacitor-updater": "^8.51.10",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "lucide-react": "^0.546.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.6.0",
    "trystero": "^0.25.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@capacitor/cli": "^8.4.3",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.0.1",
    "jsqr": "^1.4.0",
    "sharp": "^0.35.3",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.12"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
